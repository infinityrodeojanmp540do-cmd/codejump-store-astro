---
import Layout from "../layouts/Layout.astro";
import productsData from "../data/products.json";

const PICKUP_COUNT = 8;
const products = productsData.slice(0, PICKUP_COUNT);

const formatPrice = (price) =>
  `¥${new Intl.NumberFormat("ja-JP").format(price)} +tax`;
---

<Layout title="Furniture Design">
  <div class="p-home__wrapper wrapper">
    <ul class="p-home__product-list">
      {products.map((item) => (
        <li class="p-home__product-item">
          <a class="p-home__product-link" href={`/items/${item.id}`}>
            <img src={item.image} alt={item.title} />
            <p>{item.title}</p>
            <p>{formatPrice(item.price)}</p>
          </a>
        </li>
      ))}
    </ul>

    <a class="p-home__more-link" href="/products">View More</a>
  </div>
</Layout>