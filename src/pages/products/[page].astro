---
import Layout from "../../layouts/Layout.astro";
import productsData from "../../data/products.json";

export async function getStaticPaths() {
  const PER_PAGE = 12;
  const totalPages = Math.ceil(productsData.length / PER_PAGE);

  // /products は index.astro が担当、ここは /products/2 以降だけ
  return Array.from({ length: Math.max(totalPages - 1, 0) }, (_, i) => ({
    params: { page: String(i + 2) },
  }));
}

const PER_PAGE = 12;
const currentPage = Number(Astro.params.page);
const totalPages = Math.ceil(productsData.length / PER_PAGE);

const start = (currentPage - 1) * PER_PAGE;
const end = currentPage * PER_PAGE;
const products = productsData.slice(start, end);

const formatPrice = (price) =>
  `¥${new Intl.NumberFormat("ja-JP").format(price)} +tax`;
---

<Layout title="Furniture Design">
  <main class="l-main">
    <div class="p-products__wrapper wrapper">
      <h1 class="p-products__title page-title">Products</h1>

      <ul class="p-products__list">
        {products.map((item) => (
          <li class="p-products__item">
            <a class="p-products__link" href={`/items/${item.id}`}>
              <img class="p-products__img" src={item.image} alt={item.title} />
              <p class="p-products__name">{item.title}</p>
              <p class="p-products__price">{formatPrice(item.price)}</p>
            </a>
          </li>
        ))}
      </ul>

      <ul class="p-products__pagination">
        <li class="p-products__page"><a href="/products">1</a></li>

        {Array.from({ length: totalPages - 1 }, (_, i) => {
          const page = i + 2;
          const isCurrent = page === currentPage;
          return (
            <li class={`p-products__page${isCurrent ? " is-current" : ""}`}>
              {isCurrent ? page : <a href={`/products/${page}`}>{page}</a>}
            </li>
          );
        })}
      </ul>
    </div>
  </main>
</Layout>