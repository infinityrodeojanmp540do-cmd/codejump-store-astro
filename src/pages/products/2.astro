---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/footer.astro";

const allProducts = Array.from({ length: 16 }, (_, i) => ({
  href: `/items/${i + 1}`, // 仮
  image: `/img/item${i + 1}.jpg`,
  title: "プロダクトタイトルプロダクトタイトル",
  price: "¥99,999 +tax",
}));

const products = allProducts.slice(12);
---

<Layout title="Furniture Design">

  <main class="l-main">
    <div class="p-products__wrapper wrapper">
      <h1 class="p-products__title page-title">Products</h1>

      <ul class="p-products__list">
        {products.map((item) => (
          <li class="p-products__item">
            <a class="p-products__link" href={item.href}>
              <img class="p-products__img" src={item.image} alt={item.title} />
              <p class="p-products__name">{item.title}</p>
              <p class="p-products__price">{item.price}</p>
            </a>
          </li>
        ))}
      </ul>

      <ul class="p-products__pagination">
        <li class="p-products__page"><a href="/products">1</a></li>
        <li class="p-products__page is-current">2</li>
      </ul>
    </div>
  </main>

</Layout>